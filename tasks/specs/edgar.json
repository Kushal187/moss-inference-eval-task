{
  "defaults": {
    "environment": {"type": "browser", "start_url": "https://www.sec.gov/edgar/search/"},
    "limits": {"max_runtime_seconds": 600, "max_cost_usd": 0.4},
    "model": "moss-balanced",
    "output_schema": {
      "type": "object",
      "properties": {
        "found": {"type": "boolean", "description": "false if the filing or the line item could not be found"},
        "filing_url": {"type": "string", "description": "URL of the 10-K document the values came from"},
        "units": {"type": "string", "description": "units as printed in the filing, e.g. 'in millions'"},
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"period": {"type": "string"}, "value": {"type": "number"}},
            "required": ["period", "value"]
          }
        },
        "notes": {"type": "string"}
      },
      "required": ["found", "values"]
    }
  },
  "goal_template": "Using SEC EDGAR, open {company}'s annual report on Form 10-K for fiscal year {year}. In that filing, find the line item \"{item}\" and report its value for each of these periods: {periods}. Report numbers exactly as printed (keep the filing's units; use negative numbers for values shown in parentheses). If you cannot find the filing or the line item, set found=false and do not guess.",
